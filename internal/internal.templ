package internal

import (
	"fiatjaf.com/nostr"

	"github.com/fiatjaf/pyramid/global"
	"github.com/fiatjaf/pyramid/layout"
	"github.com/fiatjaf/pyramid/pyramid"
)

templ internalPage(loggedUser nostr.PubKey) {
	@layout.Layout(loggedUser, "internal") {
		<div class="flex items-center justify-between mb-4">
			<div class="flex items-center">
				if !global.Settings.Internal.IsIconDefault() {
					<img src={ global.Settings.Internal.GetIcon() } class="h-8 w-8 mr-2"/>
				}
				<h1 class="text-4xl font-bold font-[family-name:var(--primary-font)]">{ global.Settings.Internal.GetName() }</h1>
			</div>
			if global.Settings.Internal.Enabled && pyramid.IsRoot(loggedUser) {
				@layout.LandlubberButton(global.Settings.Internal.HTTPBasePath)
			}
		</div>
		<div class="space-y-4 text-gray-700 dark:text-gray-300">
			<p class="text-lg leading-relaxed">{ global.Settings.Internal.GetDescription() }</p>
			<div class="border-t border-gray-200 dark:border-gray-700 pt-4">
				<h2 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">how the internal relay works:</h2>
				<ul class="list-disc list-inside space-y-1 text-sm">
					<li>only relay members can read and write</li>
					<li>events have to be NIP-70 protected and published by the author directly</li>
				</ul>
			</div>
			if global.Settings.Internal.Enabled {
				<a
					class="mb-4 inline-flex items-center gap-2 px-2 py-1 text-blue-600 dark:text-blue-400 hover:underline themed:text-[var(--accent-color)]"
					target="_blank"
					href={ global.Settings.BrowseURI }
					x-init="$el.href = $el.href.replace(/({|%7B)url(}|%7D)/, encodeURIComponent(location.href.replace('http', 'ws').split('/').slice(0, 4).join('/')))"
				>
					browse internal →
				</a>
			}
			if pyramid.IsRoot(loggedUser) {
				@layout.SubRelaySettings(global.RelayInternal, global.Settings.Internal.Enabled, global.Settings.Internal.Name, global.Settings.Internal.Description, global.Settings.Internal.Icon, global.Settings.Internal.Pinned, global.Settings.Internal.HTTPBasePath, global.Settings.Internal.HTTPDomain)
			}
		</div>
	}
}
