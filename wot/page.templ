package wot

import (
	"fmt"
	"strings"

	"fiatjaf.com/nostr"
	"fiatjaf.com/nostr/nip19"

	"github.com/fiatjaf/pyramid/global"
	"github.com/fiatjaf/pyramid/layout"
	"github.com/fiatjaf/pyramid/pyramid"
)

templ page(loggedUser nostr.PubKey) {
	@layout.Layout(loggedUser, "wot") {
		<div class="flex items-center justify-between mb-4">
			<h1 class="text-4xl font-bold font-[family-name:var(--primary-font)]">web-of-trust</h1>
			if pyramid.IsMember(loggedUser) {
				@layout.LandlubberButton("wot")
			}
		</div>
		<div class="space-y-4 text-gray-700 dark:text-gray-300">
			<p class="text-lg leading-relaxed">
				the web-of-trust is computed from the follow lists of all relay members: people followed by members, plus the follow lists of those followed people (when followed by enough members). it decides who can post to the <a href="/inbox/" class="text-blue-600 dark:text-blue-400 themed:text-[var(--accent-color)] hover:underline">inbox</a> and <a href="/network/" class="text-blue-600 dark:text-blue-400 themed:text-[var(--accent-color)] hover:underline">network</a> relays, and automatically filters the <a href="/moderated/" class="text-blue-600 dark:text-blue-400 themed:text-[var(--accent-color)] hover:underline">moderated</a> relay.
			</p>
			if pyramid.IsMember(loggedUser) {
				<div class="border border-gray-200 dark:border-gray-700 p-4">
					if !IsComputed() {
						<span>calculating aggregated web-of-trust... it may take a few minutes after the relay starts.</span>
					} else {
						<div class="flex items-center gap-4">
							<h3 class="font-semibold text-gray-800 dark:text-gray-200">check who is in the web-of-trust</h3>
							<div class="text-sm text-gray-600 dark:text-gray-400">
								{ fmt.Sprintf("(total: %d pubkeys)", Count()) }
							</div>
						</div>
						<form
							x-data="{
								pubkey: '',
								loading: false,
								result: null,
								error: null,
								async checkWot() {
									if (!this.pubkey.trim()) {
										this.error = 'Please enter a hex pubkey or npub';
										return;
									}

									this.loading = true;
									this.result = null;
									this.error = null;

									try {
										const response = await fetch('./check-wot', {
											method: 'POST',
											headers: {
												'Content-Type': 'application/x-www-form-urlencoded',
											},
											body: 'pubkey=' + encodeURIComponent(this.pubkey.trim())
										});
										const data = await response.json();

										if (response.ok && !data.error) {
											this.result = data;
										} else {
											this.error = data.error || 'failed to check pubkey';
										}
									} catch (err) {
										this.error = 'network error: ' + err.message;
									} finally {
										this.loading = false;
									}
								}
							}"
							@submit.prevent="checkWot()"
						>
							<div class="flex items-center gap-2 mb-3">
								<input
									type="text"
									name="pubkey"
									placeholder="hex pubkey or npub..."
									class="flex-1 px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm"
									x-model="pubkey"
									@input="result = null"
								/>
								<div x-show="error" x-transition class="text-red-600 dark:text-red-400 text-sm">
									<span x-text="error"></span>
								</div>
								<div x-show="typeof result == 'boolean'" x-transition class="text-sm">
									<div x-show="result" class="text-green-600 dark:text-green-400">
										✓
									</div>
									<div x-show="!result" class="text-orange-600 dark:text-orange-400">
										✗
									</div>
								</div>
								<button
									type="submit"
									:disabled="loading"
									class="cursor-pointer px-3 py-1 text-sm bg-stone-200 hover:bg-stone-300 dark:bg-stone-600 dark:hover:bg-stone-500"
								>check</button>
							</div>
						</form>
					}
				</div>
			}
			{{
				hexes := make([]string, len(global.Settings.Wot.SpecificallyBlocked))
				npubs := make([]string, len(global.Settings.Wot.SpecificallyBlocked))
				var blockedJSON strings.Builder
				blockedJSON.WriteString("[")
				for i, pk := range global.Settings.Wot.SpecificallyBlocked {
					hexes[i] = pk.Hex()
					npubs[i] = nip19.EncodeNpub(pk)
					if i > 0 {
						blockedJSON.WriteString(",")
					}
					blockedJSON.WriteString(`{"hex":` + global.JSONString(hexes[i]) + `,"npub":` + global.JSONString(npubs[i]) + `}`)
				}
				blockedJSON.WriteString("]")
			}}
			if pyramid.IsRoot(loggedUser) {
				<div class="mt-24">
					<h3 class="text-lg font-semibold mb-4 dark:text-stone-200">configuration</h3>
					<form
						method="POST"
						action="/settings"
						x-data={ `{
							minFollowedBy: ` + global.JSONString(global.Settings.Wot.MinFollowedBy.Display()) + ` + '',
							blocked: ` + blockedJSON.String() + `,
							saved: false,
							async save() {
								const data = new FormData(this.$refs.form)
								data.delete('wot_specifically_blocked')
								for (const b of this.blocked) {
									data.append('wot_specifically_blocked', b.hex)
								}
								if (!this.blocked.length) {
									data.append('wot_specifically_blocked', '')
								}
								const response = await fetch(this.$refs.form.action, {
									method: 'POST',
									body: new URLSearchParams(data)
								})
								if (response.ok) {
									this.saved = true;
									setTimeout(() => this.saved = false, 2000)
								}
							},
							async addUser(event) {
								const profile = await event.detail;
								if (!profile || !profile.pubkey) {
									return;
								}
								const hex = profile.pubkey;
								if (this.blocked.some((b) => b.hex === hex)) {
									this.selected = '';
									return;
								}
								let npub = hex;
								try {
									const nip19 = await import('https://esm.sh/nostr-tools@2/nip19');
									npub = nip19.npubEncode(hex);
								} catch (err) {
									console.warn('failed to encode npub:', err);
								}
								this.blocked.push({hex: hex, npub: npub});
								this.selected = '';
								this.save();
							},
							async deleteUser(index) {
								this.blocked.splice(index, 1);
								this.save();
							}
						}` }
						x-ref="form"
					>
						<details>
							<summary class="mb-4 cursor-pointer text-sm font-medium text-stone-600 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200">minimum member follows for external follows</summary>
							<div class="my-4">
								<input
									type="text"
									name="wot_min_followed_by"
									id="wot_min_followed_by"
									placeholder="e.g. 2 or 10%"
									class="w-full px-4 py-2 rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-700 dark:text-stone-100 mb-2"
									x-model="minFollowedBy"
									@blur="save()"
								/>
								<p class="text-xs text-stone-500 dark:text-stone-400 mt-1 mb-4">external users enter web-of-trust after one member follow; their follows enter only after this threshold. use a number or percentage of members.</p>
							</div>
						</details>
						<details>
							<summary class="mb-4 cursor-pointer text-sm font-medium text-stone-600 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200">specifically blocked pubkeys</summary>
							<p class="text-xs text-stone-500 dark:text-stone-400 my-2">blocked pubkeys and all their follows never enter the web-of-trust, in any relay.</p>
							<nostr-user-search
								@selected={ "addUser($event)" }
								placeholder="search for users to block..."
								limit="5"
								class="part-[wrapper]:rounded part-[wrapper]:shadow-sm part-[input]:w-full part-[input]:px-3 part-[input]:py-2 part-[input]:border part-[input]:border-stone-300 part-[input]:dark:border-stone-600 part-[input]:rounded part-[input]:bg-white part-[input]:dark:bg-stone-800 part-[input]:text-stone-900 part-[input]:dark:text-stone-100 part-[input]:focus:outline-none part-[input]:focus:ring-2 part-[input]:focus:ring-stone-500 part-[results]:z-10 part-[results]:rounded part-[results]:shadow-lg part-[item]:px-3 part-[item]:py-2 part-[item]:cursor-pointer part-[item]:hover:bg-stone-100 part-[item]:dark:hover:bg-stone-700 part-[item]:text-stone-700 part-[item]:dark:text-stone-300 part-[picture]:w-10 part-[picture]:h-10 part-[picture]:rounded-full part-[name]:font-semibold part-[name]:text-stone-900 part-[name]:dark:text-stone-100 part-[nip05]:text-xs part-[nip05]:text-stone-500 part-[nip05]:dark:text-stone-400"
								relays="wss://search.nostrarchives.com,wss://relay.vertexlab.io"
							></nostr-user-search>
							<table class="min-w-full divide-y divide-stone-200 dark:divide-stone-700 mb-4">
								<thead class="bg-stone-50 dark:bg-stone-800">
									<tr>
										<th class="px-4 py-2 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">name</th>
										<th class="px-4 py-2 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">npub</th>
										<th class="px-4 py-2"></th>
									</tr>
								</thead>
								<tbody>
									<template x-for="(b, index) in blocked" :key="b.hex">
										<tr>
											<td class="px-4 py-1.5 text-sm">
												<nostr-name :pubkey="b.hex"></nostr-name>
											</td>
											<td class="px-4 py-1.5 text-sm text-stone-500 dark:text-stone-400" x-text="b.npub"></td>
											<td class="px-4 py-1.5 text-right">
												<button
													type="button"
													@click="deleteUser(index)"
													class="cursor-pointer text-stone-400 hover:text-red-600 dark:hover:text-red-400 font-bold"
													title="remove"
												>x</button>
											</td>
										</tr>
									</template>
									<tr x-show="!blocked.length">
										<td colspan="3" class="px-4 py-2 text-sm text-stone-400 dark:text-stone-500">none</td>
									</tr>
								</tbody>
							</table>
						</details>
						<div
							x-show="saved"
							x-transition
							class="text-sm text-green-600 dark:text-green-400 font-medium mb-4"
						>
							saved!
						</div>
					</form>
				</div>
			}
		</div>
	}
}
