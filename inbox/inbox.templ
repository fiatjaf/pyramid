package inbox

import (
	"fmt"
	"strings"
	"time"

	"fiatjaf.com/nostr"

	"github.com/fiatjaf/pyramid/global"
	"github.com/fiatjaf/pyramid/layout"
	"github.com/fiatjaf/pyramid/pyramid"
)

templ inboxPage(loggedUser nostr.PubKey) {
	@layout.Layout(loggedUser, "inbox") {
		<div class="flex items-center justify-between mb-4">
			<div class="flex items-center">
				if !global.Settings.Inbox.IsIconDefault() {
					<img src={ global.Settings.Inbox.GetIcon() } class="h-8 w-8 mr-2"/>
				}
				<h1 class="text-4xl font-bold font-[family-name:var(--primary-font)]">{ global.Settings.Inbox.GetName() }</h1>
			</div>
			if global.Settings.Inbox.Enabled && pyramid.IsRoot(loggedUser) {
				@layout.LandlubberButton(global.Settings.Inbox.HTTPBasePath)
			}
		</div>
		<div class="space-y-4 text-gray-700 dark:text-gray-300">
			<p class="text-lg leading-relaxed">{ global.Settings.Inbox.GetDescription() }</p>
			if pyramid.IsMember(loggedUser) {
				{{ reports := reportsForMember(loggedUser) }}
				<div class="overflow-x-auto border border-gray-200 dark:border-gray-700">
					<div class="flex items-center justify-between px-4 py-3">
						<h2 class="font-semibold text-gray-800 dark:text-gray-100">your reports</h2>
						<span class="text-sm text-gray-600 dark:text-gray-400">banned users: { fmt.Sprint(bannedCount(loggedUser)) }</span>
					</div>
					<table class="w-full text-left text-sm">
						<thead>
							<tr><th class="px-4 py-2 border-b border-gray-200 dark:border-gray-700">date</th><th class="px-4 py-2 border-b border-gray-200 dark:border-gray-700">pubkey target</th><th class="px-4 py-2 border-b border-gray-200 dark:border-gray-700">reason</th><th class="px-4 py-2 border-b border-gray-200 dark:border-gray-700">action</th></tr>
						</thead>
						<tbody>
							for report := range reports {
								<tr class="border-t border-gray-200 dark:border-gray-700">
									<td class="px-4 py-2 whitespace-nowrap">{ report.Date.Time().Format(time.DateTime) }</td>
									<td class="px-4 py-2 font-mono">{ report.Target.Hex() }</td>
									<td class="px-4 py-2">{ report.Reason }</td>
									<td class="px-4 py-2">
										<form method="POST" action={ global.Settings.Inbox.GetPageURL() + "/delete-report" }>
											<input type="hidden" name="report_id" value={ report.ID.Hex() }/>
											<button type="submit" class="text-red-600 hover:underline">delete</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<div class="border-t border-gray-200 dark:border-gray-700 pt-4">
				<h2 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">how the inbox works:</h2>
				<ul class="list-disc list-inside space-y-1 text-sm">
					<li>only events that mention a relay member and come from someone in the <a href="/wot/" class="text-blue-600 dark:text-blue-400 themed:text-[var(--accent-color)] hover:underline">web-of-trust</a> are accepted</li>
					<li>hellthreads (too many p-tags) are rejected</li>
					<li>people flagged by members (or blocked at the <a href="/wot/" class="text-blue-600 dark:text-blue-400 themed:text-[var(--accent-color)] hover:underline">web-of-trust</a> level) are filtered out</li>
					<li>encrypted DMs also require the sender to be in the web-of-trust, and can be configured to require AUTH</li>
				</ul>
			</div>
			if global.Settings.Inbox.Enabled {
				<a
					class="mb-4 inline-flex items-center gap-2 px-2 py-1 text-blue-600 dark:text-blue-400 hover:underline themed:text-[var(--accent-color)]"
					target="_blank"
					href={ global.Settings.BrowseURI }
					x-init="$el.href = $el.href.replace(/({|%7B)url(}|%7D)/, encodeURIComponent(location.href.replace('http', 'ws').split('/').slice(0, 4).join('/')))"
				>
					browse inbox →
				</a>
			}
			if pyramid.IsRoot(loggedUser) {
				@layout.SubRelaySettings(global.RelayInbox, global.Settings.Inbox.Enabled, global.Settings.Inbox.Name, global.Settings.Inbox.Description, global.Settings.Inbox.Icon, global.Settings.Inbox.Pinned, global.Settings.Inbox.HTTPBasePath, global.Settings.Inbox.HTTPDomain) {
					<details>
						<summary class="mb-4 cursor-pointer text-sm font-medium text-stone-600 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200">filters</summary>
						<form
							method="POST"
							action="/settings"
							x-data={ `{
								hellthreadLimit: ` + fmt.Sprint(global.Settings.Inbox.HellthreadLimit) + `,
								showInboxAllowedKinds: ` + fmt.Sprint(strings.TrimSpace(global.Settings.Inbox.AllowedKindsSpec) != "") + `,
								saved: false,
								async saveSettings() {
									const response = await fetch(this.$refs.form.action, {
										method: 'POST',
										body: new URLSearchParams(new FormData(this.$refs.form))
									})
									if (response.ok) {
										this.saved = true;
										setTimeout(() => this.saved = false, 2000)
									}
								}
							}` }
							x-ref="form"
						>
							<h3 class="text-lg font-semibold mb-4 dark:text-stone-200">inbox relay</h3>
							<div>
								<label class="block text-sm font-medium mb-2 dark:text-stone-300" for="inbox_hellthread_limit">hellthread limit</label>
								<input
									type="number"
									name="inbox_hellthread_limit"
									min="0"
									class="w-full px-4 py-2 rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-700 dark:text-stone-100 mb-4"
									x-model="hellthreadLimit"
									@blur="saveSettings()"
								/>
							</div>
							<div class="flex flex-col gap-1 mb-4">
								<span class="block text-sm font-medium mb-2 dark:text-stone-300">require AUTH for DMs (on top of the web-of-trust filter)</span>
								<label class="flex items-center gap-2 cursor-pointer">
									<input
										type="radio"
										name="inbox_require_auth_for_dm"
										value=""
										class="w-4 h-4"
										checked={ global.Settings.Inbox.RequireAuthForDM == "" }
										@change="saveSettings()"
									/>
									<span class="text-sm dark:text-stone-300">never</span>
								</label>
								<label class="flex items-center gap-2 cursor-pointer">
									<input
										type="radio"
										name="inbox_require_auth_for_dm"
										value="always"
										class="w-4 h-4"
										checked={ global.Settings.Inbox.RequireAuthForDM == "always" }
										@change="saveSettings()"
									/>
									<span class="text-sm dark:text-stone-300">always</span>
								</label>
							</div>
							<label class="block text-sm font-medium mb-2 dark:text-stone-300" for="inbox_allowed_kinds">allowed inbox kinds</label>
							<button
								type="button"
								x-show="!showInboxAllowedKinds"
								@mouseup="showInboxAllowedKinds = true"
								class="cursor-pointer px-3 py-1 text-sm rounded bg-stone-200 hover:bg-stone-300 dark:bg-stone-600 dark:hover:bg-stone-500"
							>
								customize inbox event kinds
							</button>
							<div x-show="showInboxAllowedKinds" x-transition>
								<div class="space-y-1">
									<textarea
										name="inbox_allowed_kinds"
										placeholder="examples:
1, 6, 7, 11, 1111, 1244
all
-6, -7, +30818"
										class="w-full px-3 py-2 rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-700 dark:text-stone-100 h-24 font-mono text-sm"
										@blur="saveSettings()"
									>
										{ global.Settings.Inbox.AllowedKindsSpec }
									</textarea>
									<p class="text-xs text-stone-500 dark:text-stone-400">
										comma-separated numbers set the full list, "all" allows all kinds, and "+/-" entries add or remove from the default list.
									</p>
								</div>
							</div>
							<div
								x-show="saved"
								x-transition
								class="text-sm text-green-600 dark:text-green-400 font-medium mb-4"
							>
								saved!
							</div>
						</form>
					</details>
				}
			}
		</div>
	}
}
